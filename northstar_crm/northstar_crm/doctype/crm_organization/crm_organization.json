{
  "doctype": "DocType",
  "name": "CRM Organization",
  "module": "Northstar CRM",
  "autoname": "format:ORG-.#####",
  "title_field": "organization_name",
  "search_fields": "organization_name,website,primary_email",
  "allow_rename": 1,
  "track_changes": 1,
  "sort_field": "modified",
  "sort_order": "DESC",
  "field_order": [
    "identity_section", "organization_name", "lifecycle_stage", "segment", "industry", "territory",
    "contact_section", "website", "primary_email", "phone", "city", "country",
    "ownership_section", "account_manager", "currency", "annual_revenue", "employee_count", "health_score",
    "activity_section", "last_activity_on", "last_activity_type", "tags", "notes",
    "compliance_section", "tax_id", "registration_number", "data_classification"
  ],
  "fields": [
    {"fieldname": "identity_section", "fieldtype": "Section Break", "label": "Identity"},
    {"fieldname": "organization_name", "fieldtype": "Data", "label": "Organization Name", "reqd": 1, "unique": 1, "in_list_view": 1, "in_global_search": 1},
    {"fieldname": "lifecycle_stage", "fieldtype": "Select", "label": "Lifecycle Stage", "options": "Prospect\nCustomer\nPartner\nDormant\nArchived", "default": "Prospect", "reqd": 1, "in_list_view": 1},
    {"fieldname": "segment", "fieldtype": "Select", "label": "Segment", "options": "Enterprise\nMid-Market\nSMB\nPublic Sector\nNonprofit"},
    {"fieldname": "industry", "fieldtype": "Data", "label": "Industry", "in_standard_filter": 1},
    {"fieldname": "territory", "fieldtype": "Data", "label": "Territory", "in_standard_filter": 1},
    {"fieldname": "contact_section", "fieldtype": "Section Break", "label": "Contact and Location"},
    {"fieldname": "website", "fieldtype": "Data", "label": "Website", "options": "URL"},
    {"fieldname": "primary_email", "fieldtype": "Data", "label": "Primary Email", "options": "Email"},
    {"fieldname": "phone", "fieldtype": "Data", "label": "Phone", "options": "Phone"},
    {"fieldname": "city", "fieldtype": "Data", "label": "City"},
    {"fieldname": "country", "fieldtype": "Link", "label": "Country", "options": "Country"},
    {"fieldname": "ownership_section", "fieldtype": "Section Break", "label": "Ownership and Value"},
    {"fieldname": "account_manager", "fieldtype": "Link", "label": "Account Manager", "options": "User", "reqd": 1, "default": "__user", "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "currency", "fieldtype": "Link", "label": "Currency", "options": "Currency", "reqd": 1},
    {"fieldname": "annual_revenue", "fieldtype": "Currency", "label": "Annual Revenue", "options": "currency"},
    {"fieldname": "employee_count", "fieldtype": "Int", "label": "Employees", "non_negative": 1},
    {"fieldname": "health_score", "fieldtype": "Int", "label": "Relationship Health", "read_only": 1, "default": 50},
    {"fieldname": "activity_section", "fieldtype": "Section Break", "label": "Relationship Context"},
    {"fieldname": "last_activity_on", "fieldtype": "Datetime", "label": "Last Activity On", "read_only": 1},
    {"fieldname": "last_activity_type", "fieldtype": "Data", "label": "Last Activity Type", "read_only": 1},
    {"fieldname": "tags", "fieldtype": "Small Text", "label": "Tags"},
    {"fieldname": "notes", "fieldtype": "Text Editor", "label": "Account Notes"},
    {"fieldname": "compliance_section", "fieldtype": "Section Break", "label": "Restricted Identity Data"},
    {"fieldname": "tax_id", "fieldtype": "Data", "label": "Tax Identifier", "permlevel": 1},
    {"fieldname": "registration_number", "fieldtype": "Data", "label": "Registration Number", "permlevel": 1},
    {"fieldname": "data_classification", "fieldtype": "Select", "label": "Data Classification", "options": "Public\nInternal\nConfidential\nRestricted", "default": "Internal", "permlevel": 1}
  ],
  "permissions": [
    {"role": "CRM Sales User", "read": 1, "write": 1, "create": 1, "email": 1, "print": 1, "share": 1},
    {"role": "CRM Sales Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "email": 1, "export": 1, "print": 1, "report": 1, "share": 1},
    {"role": "CRM Sales Manager", "permlevel": 1, "read": 1, "write": 1},
    {"role": "CRM Analyst", "read": 1, "export": 1, "report": 1},
    {"role": "CRM Compliance Manager", "read": 1, "export": 1, "report": 1},
    {"role": "CRM Compliance Manager", "permlevel": 1, "read": 1, "write": 1},
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "export": 1, "print": 1, "report": 1, "share": 1},
    {"role": "System Manager", "permlevel": 1, "read": 1, "write": 1}
  ]
}
