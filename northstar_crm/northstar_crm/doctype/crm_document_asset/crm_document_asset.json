{
  "doctype": "DocType",
  "name": "CRM Document Asset",
  "module": "Northstar CRM",
  "autoname": "format:DOC-.YYYY.-.#####",
  "title_field": "title",
  "search_fields": "title,organization,document_type,tags",
  "track_changes": 1,
  "sort_field": "modified",
  "sort_order": "DESC",
  "field_order": [
    "identity_section", "title", "document_type", "file_url", "organization", "reference_doctype", "reference_name", "source_channel", "tags",
    "governance_section", "classification", "contains_pii", "legal_hold", "retention_until", "content_owner", "checksum_sha256", "mime_type", "file_size_bytes",
    "intelligence_section", "extract_text", "extraction_status", "character_count", "extracted_text", "extraction_error", "schema_version", "derived_metadata"
  ],
  "fields": [
    {"fieldname": "identity_section", "fieldtype": "Section Break", "label": "Document Identity"},
    {"fieldname": "title", "fieldtype": "Data", "label": "Title", "reqd": 1, "in_list_view": 1, "in_global_search": 1},
    {"fieldname": "document_type", "fieldtype": "Select", "label": "Document Type", "options": "Proposal\nContract\nRequirement\nMeeting Notes\nCall Recording\nEmail Export\nPresentation\nTechnical Design\nSecurity Questionnaire\nIdentity Evidence\nOther", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "file_url", "fieldtype": "Attach", "label": "File", "reqd": 1},
    {"fieldname": "organization", "fieldtype": "Link", "label": "Organization", "options": "CRM Organization", "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "reference_doctype", "fieldtype": "Link", "label": "Reference Type", "options": "DocType"},
    {"fieldname": "reference_name", "fieldtype": "Dynamic Link", "label": "Reference", "options": "reference_doctype"},
    {"fieldname": "source_channel", "fieldtype": "Select", "label": "Source Channel", "options": "Manual Upload\nEmail\nAPI\nWeb Form\nMeeting\nCall\nIntegration", "default": "Manual Upload"},
    {"fieldname": "tags", "fieldtype": "Small Text", "label": "Tags"},
    {"fieldname": "governance_section", "fieldtype": "Section Break", "label": "Governance"},
    {"fieldname": "classification", "fieldtype": "Select", "label": "Classification", "options": "Public\nInternal\nConfidential\nRestricted", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "contains_pii", "fieldtype": "Check", "label": "Contains Personal Data", "default": 0},
    {"fieldname": "legal_hold", "fieldtype": "Check", "label": "Legal Hold", "default": 0, "permlevel": 1},
    {"fieldname": "retention_until", "fieldtype": "Date", "label": "Retain Until", "permlevel": 1},
    {"fieldname": "content_owner", "fieldtype": "Link", "label": "Content Owner", "options": "User", "default": "__user", "reqd": 1},
    {"fieldname": "checksum_sha256", "fieldtype": "Data", "label": "SHA-256 Checksum", "read_only": 1},
    {"fieldname": "mime_type", "fieldtype": "Data", "label": "MIME Type", "read_only": 1},
    {"fieldname": "file_size_bytes", "fieldtype": "Int", "label": "File Size (Bytes)", "read_only": 1},
    {"fieldname": "intelligence_section", "fieldtype": "Section Break", "label": "Content Intelligence"},
    {"fieldname": "extract_text", "fieldtype": "Check", "label": "Extract Searchable Text", "default": 1},
    {"fieldname": "extraction_status", "fieldtype": "Select", "label": "Extraction Status", "options": "Not Requested\nQueued\nProcessing\nCompleted\nManual Review\nFailed", "default": "Not Requested", "read_only": 1, "in_list_view": 1},
    {"fieldname": "character_count", "fieldtype": "Int", "label": "Extracted Characters", "read_only": 1},
    {"fieldname": "extracted_text", "fieldtype": "Long Text", "label": "Extracted Text", "read_only": 1},
    {"fieldname": "extraction_error", "fieldtype": "Long Text", "label": "Extraction Error", "read_only": 1},
    {"fieldname": "schema_version", "fieldtype": "Data", "label": "Derived Metadata Schema", "default": "1.0", "read_only": 1},
    {"fieldname": "derived_metadata", "fieldtype": "JSON", "label": "Derived Metadata", "read_only": 1}
  ],
  "permissions": [
    {"role": "CRM Sales User", "read": 1, "write": 1, "create": 1},
    {"role": "CRM Sales Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "export": 1, "report": 1},
    {"role": "CRM Sales Manager", "permlevel": 1, "read": 1},
    {"role": "CRM Analyst", "read": 1, "report": 1},
    {"role": "CRM Compliance Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "export": 1, "report": 1},
    {"role": "CRM Compliance Manager", "permlevel": 1, "read": 1, "write": 1},
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "export": 1, "report": 1},
    {"role": "System Manager", "permlevel": 1, "read": 1, "write": 1}
  ]
}
