{
  "doctype": "DocType",
  "name": "CRM Integration Event",
  "module": "Northstar CRM",
  "autoname": "format:INT-.YYYY.-.#####",
  "title_field": "event_type",
  "search_fields": "event_type,source_system,idempotency_key,reference_name",
  "track_changes": 1,
  "sort_field": "received_on",
  "sort_order": "DESC",
  "field_order": [
    "identity_section", "direction", "source_system", "event_type", "idempotency_key", "schema_version", "status",
    "payload_section", "payload_json", "response_json",
    "processing_section", "received_on", "last_attempt_on", "processed_on", "retry_count", "last_error",
    "reference_section", "reference_doctype", "reference_name"
  ],
  "fields": [
    {"fieldname": "identity_section", "fieldtype": "Section Break", "label": "Integration Event"},
    {"fieldname": "direction", "fieldtype": "Select", "label": "Direction", "options": "Inbound\nOutbound", "reqd": 1, "in_list_view": 1},
    {"fieldname": "source_system", "fieldtype": "Data", "label": "Source System", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "event_type", "fieldtype": "Data", "label": "Event Type", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "idempotency_key", "fieldtype": "Data", "label": "Idempotency Key", "reqd": 1, "unique": 1, "in_list_view": 1},
    {"fieldname": "schema_version", "fieldtype": "Data", "label": "Schema Version", "default": "1.0", "reqd": 1},
    {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Received\nProcessing\nApplied\nFailed\nRetrying\nManual Review\nIgnored", "default": "Received", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "payload_section", "fieldtype": "Section Break", "label": "Semi-structured Payload"},
    {"fieldname": "payload_json", "fieldtype": "JSON", "label": "Payload", "reqd": 1},
    {"fieldname": "response_json", "fieldtype": "JSON", "label": "Response"},
    {"fieldname": "processing_section", "fieldtype": "Section Break", "label": "Processing"},
    {"fieldname": "received_on", "fieldtype": "Datetime", "label": "Received On", "reqd": 1, "in_list_view": 1},
    {"fieldname": "last_attempt_on", "fieldtype": "Datetime", "label": "Last Attempt On", "read_only": 1},
    {"fieldname": "processed_on", "fieldtype": "Datetime", "label": "Processed On", "read_only": 1},
    {"fieldname": "retry_count", "fieldtype": "Int", "label": "Retry Count", "default": 0, "read_only": 1},
    {"fieldname": "last_error", "fieldtype": "Long Text", "label": "Last Error", "read_only": 1},
    {"fieldname": "reference_section", "fieldtype": "Section Break", "label": "Applied Reference"},
    {"fieldname": "reference_doctype", "fieldtype": "Link", "label": "Reference Type", "options": "DocType", "read_only": 1},
    {"fieldname": "reference_name", "fieldtype": "Dynamic Link", "label": "Reference", "options": "reference_doctype", "read_only": 1}
  ],
  "permissions": [
    {"role": "CRM Integration User", "read": 1, "create": 1},
    {"role": "CRM Sales Manager", "read": 1, "report": 1},
    {"role": "CRM Analyst", "read": 1, "report": 1},
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "export": 1, "report": 1}
  ]
}

