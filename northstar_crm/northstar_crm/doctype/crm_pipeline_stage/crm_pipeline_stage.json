{
  "doctype": "DocType",
  "name": "CRM Pipeline Stage",
  "module": "Northstar CRM",
  "autoname": "field:stage_name",
  "title_field": "stage_name",
  "allow_rename": 1,
  "track_changes": 1,
  "sort_field": "sequence",
  "sort_order": "ASC",
  "field_order": ["stage_name", "sequence", "probability", "color", "is_won", "is_lost", "exit_criteria", "disabled"],
  "fields": [
    {"fieldname": "stage_name", "fieldtype": "Data", "label": "Stage Name", "reqd": 1, "unique": 1, "in_list_view": 1},
    {"fieldname": "sequence", "fieldtype": "Int", "label": "Sequence", "reqd": 1, "unique": 1, "in_list_view": 1},
    {"fieldname": "probability", "fieldtype": "Percent", "label": "Default Probability", "reqd": 1, "in_list_view": 1},
    {"fieldname": "color", "fieldtype": "Color", "label": "Color"},
    {"fieldname": "is_won", "fieldtype": "Check", "label": "Won Stage", "default": 0},
    {"fieldname": "is_lost", "fieldtype": "Check", "label": "Lost Stage", "default": 0},
    {"fieldname": "exit_criteria", "fieldtype": "Small Text", "label": "Exit Criteria"},
    {"fieldname": "disabled", "fieldtype": "Check", "label": "Disabled", "default": 0}
  ],
  "permissions": [
    {"role": "CRM Sales User", "read": 1},
    {"role": "CRM Sales Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "export": 1, "report": 1},
    {"role": "CRM Analyst", "read": 1, "report": 1},
    {"role": "CRM Compliance Manager", "read": 1},
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "export": 1, "report": 1}
  ]
}
