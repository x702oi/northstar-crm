{
  "doctype": "DocType",
  "name": "CRM Lead",
  "module": "Northstar CRM",
  "autoname": "format:LEAD-.YYYY.-.#####",
  "title_field": "lead_name",
  "search_fields": "lead_name,organization_name,email,mobile_no",
  "track_changes": 1,
  "sort_field": "modified",
  "sort_order": "DESC",
  "field_order": [
    "identity_section", "lead_name", "organization_name", "email", "mobile_no", "source", "campaign", "industry",
    "ownership_section", "status", "rating", "lead_owner", "territory",
    "qualification_section", "business_need", "decision_authority", "estimated_value", "currency", "target_close_date", "competitor",
    "score_section", "lead_score", "engagement_score", "score_breakdown",
    "activity_section", "last_activity_on", "last_activity_type", "next_action", "next_action_on", "notes",
    "conversion_section", "converted_opportunity"
  ],
  "fields": [
    {"fieldname": "identity_section", "fieldtype": "Section Break", "label": "Lead Identity"},
    {"fieldname": "lead_name", "fieldtype": "Data", "label": "Lead Name", "reqd": 1, "in_list_view": 1, "in_global_search": 1},
    {"fieldname": "organization_name", "fieldtype": "Data", "label": "Organization", "in_list_view": 1},
    {"fieldname": "email", "fieldtype": "Data", "label": "Email", "options": "Email", "in_list_view": 1},
    {"fieldname": "mobile_no", "fieldtype": "Data", "label": "Mobile", "options": "Phone"},
    {"fieldname": "source", "fieldtype": "Select", "label": "Lead Source", "options": "Website\nReferral\nCampaign\nEvent\nOutbound\nPartner\nSocial\nOther", "default": "Website", "in_standard_filter": 1},
    {"fieldname": "campaign", "fieldtype": "Data", "label": "Campaign"},
    {"fieldname": "industry", "fieldtype": "Data", "label": "Industry"},
    {"fieldname": "ownership_section", "fieldtype": "Section Break", "label": "Ownership and Status"},
    {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "New\nContacted\nQualified\nNurturing\nConverted\nDisqualified\nArchived", "default": "New", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "rating", "fieldtype": "Select", "label": "Rating", "options": "Cold\nWarm\nHot", "default": "Cold", "read_only": 1, "in_list_view": 1},
    {"fieldname": "lead_owner", "fieldtype": "Link", "label": "Lead Owner", "options": "User", "default": "__user", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "territory", "fieldtype": "Data", "label": "Territory"},
    {"fieldname": "qualification_section", "fieldtype": "Section Break", "label": "Qualification (Need, Authority, Budget, Timeline)"},
    {"fieldname": "business_need", "fieldtype": "Small Text", "label": "Business Need"},
    {"fieldname": "decision_authority", "fieldtype": "Select", "label": "Decision Authority", "options": "Unknown\nInfluencer\nEvaluator\nDecision Maker\nExecutive Sponsor", "default": "Unknown"},
    {"fieldname": "estimated_value", "fieldtype": "Currency", "label": "Estimated Value", "options": "currency", "non_negative": 1},
    {"fieldname": "currency", "fieldtype": "Link", "label": "Currency", "options": "Currency", "reqd": 1},
    {"fieldname": "target_close_date", "fieldtype": "Date", "label": "Target Close Date"},
    {"fieldname": "competitor", "fieldtype": "Data", "label": "Known Competitor"},
    {"fieldname": "score_section", "fieldtype": "Section Break", "label": "Scoring"},
    {"fieldname": "lead_score", "fieldtype": "Int", "label": "Lead Score", "read_only": 1, "in_list_view": 1},
    {"fieldname": "engagement_score", "fieldtype": "Int", "label": "Engagement Score", "default": 0},
    {"fieldname": "score_breakdown", "fieldtype": "JSON", "label": "Score Breakdown", "read_only": 1},
    {"fieldname": "activity_section", "fieldtype": "Section Break", "label": "Follow-up"},
    {"fieldname": "last_activity_on", "fieldtype": "Datetime", "label": "Last Activity On", "read_only": 1},
    {"fieldname": "last_activity_type", "fieldtype": "Data", "label": "Last Activity Type", "read_only": 1},
    {"fieldname": "next_action", "fieldtype": "Data", "label": "Next Action"},
    {"fieldname": "next_action_on", "fieldtype": "Datetime", "label": "Next Action On"},
    {"fieldname": "notes", "fieldtype": "Text Editor", "label": "Notes"},
    {"fieldname": "conversion_section", "fieldtype": "Section Break", "label": "Conversion"},
    {"fieldname": "converted_opportunity", "fieldtype": "Link", "label": "Converted Opportunity", "options": "CRM Opportunity", "read_only": 1}
  ],
  "permissions": [
    {"role": "CRM Sales User", "read": 1, "write": 1, "create": 1, "email": 1, "print": 1, "share": 1},
    {"role": "CRM Sales Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "email": 1, "export": 1, "import": 1, "print": 1, "report": 1, "share": 1},
    {"role": "CRM Analyst", "read": 1, "export": 1, "report": 1},
    {"role": "CRM Compliance Manager", "read": 1, "export": 1},
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "export": 1, "import": 1, "print": 1, "report": 1, "share": 1}
  ]
}
