{
  "doctype": "DocType",
  "name": "CRM Activity",
  "module": "Northstar CRM",
  "autoname": "format:ACT-.YYYY.-.#####",
  "title_field": "subject",
  "search_fields": "subject,organization,reference_name,owner_user",
  "track_changes": 1,
  "sort_field": "activity_datetime",
  "sort_order": "DESC",
  "field_order": [
    "activity_section", "activity_type", "subject", "status", "priority", "activity_datetime", "duration_minutes",
    "reference_section", "reference_doctype", "reference_name", "organization", "contact", "owner_user",
    "content_section", "notes", "email_body", "call_transcript", "meeting_summary", "outcome", "next_action", "next_action_on",
    "metadata_section", "channel_message_id", "external_event_id", "sentiment", "topics"
  ],
  "fields": [
    {"fieldname": "activity_section", "fieldtype": "Section Break", "label": "Activity"},
    {"fieldname": "activity_type", "fieldtype": "Select", "label": "Activity Type", "options": "Call\nEmail\nMeeting\nTask\nNote\nSMS\nWhatsApp\nStage Change\nProposal Sent\nContract Event", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "subject", "fieldtype": "Data", "label": "Subject", "reqd": 1, "in_list_view": 1, "in_global_search": 1},
    {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Open\nScheduled\nCompleted\nCancelled", "default": "Open", "reqd": 1, "in_list_view": 1},
    {"fieldname": "priority", "fieldtype": "Select", "label": "Priority", "options": "Low\nMedium\nHigh\nUrgent", "default": "Medium"},
    {"fieldname": "activity_datetime", "fieldtype": "Datetime", "label": "Date and Time", "reqd": 1, "in_list_view": 1},
    {"fieldname": "duration_minutes", "fieldtype": "Int", "label": "Duration (Minutes)", "non_negative": 1},
    {"fieldname": "reference_section", "fieldtype": "Section Break", "label": "CRM Reference"},
    {"fieldname": "reference_doctype", "fieldtype": "Link", "label": "Reference Type", "options": "DocType", "reqd": 1},
    {"fieldname": "reference_name", "fieldtype": "Dynamic Link", "label": "Reference", "options": "reference_doctype", "reqd": 1, "in_list_view": 1},
    {"fieldname": "organization", "fieldtype": "Link", "label": "Organization", "options": "CRM Organization", "in_standard_filter": 1},
    {"fieldname": "contact", "fieldtype": "Link", "label": "Contact", "options": "CRM Contact"},
    {"fieldname": "owner_user", "fieldtype": "Link", "label": "Assigned To", "options": "User", "default": "__user", "reqd": 1, "in_standard_filter": 1},
    {"fieldname": "content_section", "fieldtype": "Section Break", "label": "Unstructured Interaction Content"},
    {"fieldname": "notes", "fieldtype": "Text Editor", "label": "Notes"},
    {"fieldname": "email_body", "fieldtype": "Text Editor", "label": "Email Body"},
    {"fieldname": "call_transcript", "fieldtype": "Long Text", "label": "Call Transcript"},
    {"fieldname": "meeting_summary", "fieldtype": "Text Editor", "label": "Meeting Summary"},
    {"fieldname": "outcome", "fieldtype": "Select", "label": "Outcome", "options": "Positive\nNeutral\nNegative\nNo Answer\nRescheduled\nAction Required"},
    {"fieldname": "next_action", "fieldtype": "Data", "label": "Next Action"},
    {"fieldname": "next_action_on", "fieldtype": "Datetime", "label": "Next Action On"},
    {"fieldname": "metadata_section", "fieldtype": "Section Break", "label": "Integration and Derived Metadata"},
    {"fieldname": "channel_message_id", "fieldtype": "Data", "label": "Channel Message ID", "unique": 1},
    {"fieldname": "external_event_id", "fieldtype": "Data", "label": "External Event ID"},
    {"fieldname": "sentiment", "fieldtype": "Select", "label": "Derived Sentiment", "options": "Positive\nNeutral\nNegative\nUnknown", "default": "Unknown", "read_only": 1},
    {"fieldname": "topics", "fieldtype": "Small Text", "label": "Derived Topics", "read_only": 1}
  ],
  "permissions": [
    {"role": "CRM Sales User", "read": 1, "write": 1, "create": 1, "email": 1},
    {"role": "CRM Sales Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "email": 1, "export": 1, "report": 1},
    {"role": "CRM Analyst", "read": 1, "report": 1},
    {"role": "CRM Compliance Manager", "read": 1, "export": 1, "report": 1},
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "export": 1, "report": 1}
  ]
}

