{
  "doctype": "DocType",
  "name": "CRM Opportunity",
  "module": "Northstar CRM",
  "autoname": "format:OPP-.YYYY.-.#####",
  "title_field": "opportunity_name",
  "search_fields": "opportunity_name,organization,primary_contact,source_lead",
  "track_changes": 1,
  "sort_field": "expected_close_date",
  "sort_order": "ASC",
  "field_order": [
    "identity_section", "opportunity_name", "organization", "primary_contact", "source_lead", "opportunity_type",
    "pipeline_section", "pipeline_stage", "status", "forecast_category", "probability", "expected_close_date", "stage_entered_on", "is_stale",
    "value_section", "currency", "amount", "weighted_amount", "expected_recurring_revenue", "discount_requested",
    "ownership_section", "opportunity_owner", "sales_team", "territory", "competitor", "loss_reason",
    "stakeholders_section", "stakeholders", "items_section", "items",
    "context_section", "business_problem", "solution_summary", "risks", "next_step", "last_activity_on", "last_activity_type"
  ],
  "fields": [
    {"fieldname": "identity_section", "fieldtype": "Section Break", "label": "Opportunity"},
    {"fieldname": "opportunity_name", "fieldtype": "Data", "label": "Opportunity Name", "reqd": 1, "in_list_view": 1, "in_global_search": 1},
    {"fieldname": "organization", "fieldtype": "Link", "label": "Organization", "options": "CRM Organization", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "primary_contact", "fieldtype": "Link", "label": "Primary Contact", "options": "CRM Contact"},
    {"fieldname": "source_lead", "fieldtype": "Link", "label": "Source Lead", "options": "CRM Lead", "read_only": 1},
    {"fieldname": "opportunity_type", "fieldtype": "Select", "label": "Type", "options": "New Business\nExpansion\nRenewal\nCross-sell\nUpsell", "default": "New Business"},
    {"fieldname": "pipeline_section", "fieldtype": "Section Break", "label": "Pipeline and Forecast"},
    {"fieldname": "pipeline_stage", "fieldtype": "Link", "label": "Pipeline Stage", "options": "CRM Pipeline Stage", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Open\nOn Hold\nWon\nLost\nCancelled", "default": "Open", "reqd": 1, "in_list_view": 1},
    {"fieldname": "forecast_category", "fieldtype": "Select", "label": "Forecast Category", "options": "Pipeline\nBest Case\nCommit\nClosed", "default": "Pipeline", "in_standard_filter": 1},
    {"fieldname": "probability", "fieldtype": "Percent", "label": "Probability", "read_only": 1, "in_list_view": 1},
    {"fieldname": "expected_close_date", "fieldtype": "Date", "label": "Expected Close Date", "reqd": 1, "in_list_view": 1},
    {"fieldname": "stage_entered_on", "fieldtype": "Datetime", "label": "Stage Entered On", "read_only": 1},
    {"fieldname": "is_stale", "fieldtype": "Check", "label": "Stale", "read_only": 1, "in_list_view": 1},
    {"fieldname": "value_section", "fieldtype": "Section Break", "label": "Commercial Value"},
    {"fieldname": "currency", "fieldtype": "Link", "label": "Currency", "options": "Currency", "reqd": 1},
    {"fieldname": "amount", "fieldtype": "Currency", "label": "Opportunity Value", "options": "currency", "non_negative": 1, "in_list_view": 1},
    {"fieldname": "weighted_amount", "fieldtype": "Currency", "label": "Weighted Value", "options": "currency", "read_only": 1},
    {"fieldname": "expected_recurring_revenue", "fieldtype": "Currency", "label": "Expected Recurring Revenue", "options": "currency", "non_negative": 1},
    {"fieldname": "discount_requested", "fieldtype": "Percent", "label": "Discount Requested", "permlevel": 1},
    {"fieldname": "ownership_section", "fieldtype": "Section Break", "label": "Ownership and Competition"},
    {"fieldname": "opportunity_owner", "fieldtype": "Link", "label": "Opportunity Owner", "options": "User", "default": "__user", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "sales_team", "fieldtype": "Data", "label": "Sales Team"},
    {"fieldname": "territory", "fieldtype": "Data", "label": "Territory"},
    {"fieldname": "competitor", "fieldtype": "Data", "label": "Competitor"},
    {"fieldname": "loss_reason", "fieldtype": "Small Text", "label": "Loss Reason", "depends_on": "eval:doc.status=='Lost'", "mandatory_depends_on": "eval:doc.status=='Lost'"},
    {"fieldname": "stakeholders_section", "fieldtype": "Section Break", "label": "Stakeholders"},
    {"fieldname": "stakeholders", "fieldtype": "Table", "label": "Stakeholders", "options": "CRM Opportunity Stakeholder"},
    {"fieldname": "items_section", "fieldtype": "Section Break", "label": "Products and Services"},
    {"fieldname": "items", "fieldtype": "Table", "label": "Opportunity Items", "options": "CRM Opportunity Item"},
    {"fieldname": "context_section", "fieldtype": "Section Break", "label": "Deal Context"},
    {"fieldname": "business_problem", "fieldtype": "Text Editor", "label": "Business Problem"},
    {"fieldname": "solution_summary", "fieldtype": "Text Editor", "label": "Proposed Solution"},
    {"fieldname": "risks", "fieldtype": "Small Text", "label": "Risks and Blockers"},
    {"fieldname": "next_step", "fieldtype": "Data", "label": "Next Step"},
    {"fieldname": "last_activity_on", "fieldtype": "Datetime", "label": "Last Activity On", "read_only": 1},
    {"fieldname": "last_activity_type", "fieldtype": "Data", "label": "Last Activity Type", "read_only": 1}
  ],
  "permissions": [
    {"role": "CRM Sales User", "read": 1, "write": 1, "create": 1, "email": 1, "print": 1, "share": 1},
    {"role": "CRM Sales Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "email": 1, "export": 1, "import": 1, "print": 1, "report": 1, "share": 1},
    {"role": "CRM Sales Manager", "permlevel": 1, "read": 1, "write": 1},
    {"role": "CRM Analyst", "read": 1, "export": 1, "report": 1},
    {"role": "CRM Compliance Manager", "read": 1},
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "export": 1, "import": 1, "print": 1, "report": 1, "share": 1},
    {"role": "System Manager", "permlevel": 1, "read": 1, "write": 1}
  ]
}
