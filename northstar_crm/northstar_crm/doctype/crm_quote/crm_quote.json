{
  "doctype": "DocType",
  "name": "CRM Quote",
  "module": "Northstar CRM",
  "autoname": "format:QTN-.YYYY.-.#####",
  "title_field": "quote_title",
  "search_fields": "quote_title,organization,opportunity,primary_contact",
  "is_submittable": 1,
  "track_changes": 1,
  "sort_field": "modified",
  "sort_order": "DESC",
  "field_order": [
    "identity_section", "quote_title", "opportunity", "organization", "primary_contact", "quote_status", "approval_status", "approval_signature", "version_no", "valid_until",
    "items_section", "items",
    "totals_section", "currency", "subtotal", "additional_discount_percent", "discount_amount", "tax_percent", "tax_amount", "grand_total",
    "commercial_section", "payment_terms", "delivery_terms", "assumptions", "exclusions", "internal_notes",
    "approval_section", "requested_by", "approved_by", "approved_on", "rejection_reason"
  ],
  "fields": [
    {"fieldname": "identity_section", "fieldtype": "Section Break", "label": "Quote"},
    {"fieldname": "quote_title", "fieldtype": "Data", "label": "Quote Title", "reqd": 1, "in_list_view": 1, "in_global_search": 1},
    {"fieldname": "opportunity", "fieldtype": "Link", "label": "Opportunity", "options": "CRM Opportunity", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "organization", "fieldtype": "Link", "label": "Organization", "options": "CRM Organization", "reqd": 1, "in_list_view": 1},
    {"fieldname": "primary_contact", "fieldtype": "Link", "label": "Primary Contact", "options": "CRM Contact"},
    {"fieldname": "quote_status", "fieldtype": "Select", "label": "Quote Status", "options": "Draft\nUnder Review\nApproved\nSent\nAccepted\nRejected\nExpired", "default": "Draft", "reqd": 1, "read_only": 1, "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "approval_status", "fieldtype": "Select", "label": "Approval Status", "options": "Not Required\nPending\nApproved\nRejected", "default": "Not Required", "reqd": 1, "read_only": 1, "in_list_view": 1},
    {"fieldname": "approval_signature", "fieldtype": "Data", "label": "Approval Signature", "read_only": 1, "hidden": 1},
    {"fieldname": "version_no", "fieldtype": "Int", "label": "Commercial Version", "default": 1, "reqd": 1},
    {"fieldname": "valid_until", "fieldtype": "Date", "label": "Valid Until", "reqd": 1, "in_list_view": 1},
    {"fieldname": "items_section", "fieldtype": "Section Break", "label": "Products and Services"},
    {"fieldname": "items", "fieldtype": "Table", "label": "Quote Items", "options": "CRM Quote Item", "reqd": 1},
    {"fieldname": "totals_section", "fieldtype": "Section Break", "label": "Commercial Totals"},
    {"fieldname": "currency", "fieldtype": "Link", "label": "Currency", "options": "Currency", "reqd": 1},
    {"fieldname": "subtotal", "fieldtype": "Currency", "label": "Subtotal", "options": "currency", "read_only": 1},
    {"fieldname": "additional_discount_percent", "fieldtype": "Percent", "label": "Additional Discount", "default": 0, "permlevel": 1},
    {"fieldname": "discount_amount", "fieldtype": "Currency", "label": "Discount Amount", "options": "currency", "read_only": 1},
    {"fieldname": "tax_percent", "fieldtype": "Percent", "label": "Tax", "default": 15},
    {"fieldname": "tax_amount", "fieldtype": "Currency", "label": "Tax Amount", "options": "currency", "read_only": 1},
    {"fieldname": "grand_total", "fieldtype": "Currency", "label": "Grand Total", "options": "currency", "read_only": 1, "in_list_view": 1},
    {"fieldname": "commercial_section", "fieldtype": "Section Break", "label": "Commercial Terms"},
    {"fieldname": "payment_terms", "fieldtype": "Text Editor", "label": "Payment Terms"},
    {"fieldname": "delivery_terms", "fieldtype": "Text Editor", "label": "Delivery Terms"},
    {"fieldname": "assumptions", "fieldtype": "Text Editor", "label": "Assumptions"},
    {"fieldname": "exclusions", "fieldtype": "Text Editor", "label": "Exclusions"},
    {"fieldname": "internal_notes", "fieldtype": "Text Editor", "label": "Internal Notes", "permlevel": 1},
    {"fieldname": "approval_section", "fieldtype": "Section Break", "label": "Approval Audit"},
    {"fieldname": "requested_by", "fieldtype": "Link", "label": "Requested By", "options": "User", "read_only": 1},
    {"fieldname": "approved_by", "fieldtype": "Link", "label": "Approved By", "options": "User", "read_only": 1},
    {"fieldname": "approved_on", "fieldtype": "Datetime", "label": "Approved On", "read_only": 1},
    {"fieldname": "rejection_reason", "fieldtype": "Small Text", "label": "Rejection Reason", "depends_on": "eval:doc.approval_status=='Rejected'"}
  ],
  "permissions": [
    {"role": "CRM Sales User", "read": 1, "write": 1, "create": 1, "submit": 1, "email": 1, "print": 1},
    {"role": "CRM Sales Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "submit": 1, "cancel": 1, "amend": 1, "email": 1, "export": 1, "print": 1, "report": 1},
    {"role": "CRM Sales Manager", "permlevel": 1, "read": 1, "write": 1},
    {"role": "CRM Analyst", "read": 1, "report": 1},
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "submit": 1, "cancel": 1, "amend": 1, "export": 1, "print": 1, "report": 1},
    {"role": "System Manager", "permlevel": 1, "read": 1, "write": 1}
  ]
}
