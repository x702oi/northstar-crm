{
  "doctype": "DocType",
  "name": "CRM Contact",
  "module": "Northstar CRM",
  "autoname": "format:CON-.#####",
  "title_field": "full_name",
  "search_fields": "full_name,email,mobile_no,organization",
  "allow_rename": 1,
  "track_changes": 1,
  "sort_field": "modified",
  "sort_order": "DESC",
  "field_order": [
    "identity_section", "full_name", "organization", "job_title", "department", "status", "is_primary",
    "communication_section", "email", "mobile_no", "preferred_channel", "preferred_language", "timezone",
    "relationship_section", "buying_role", "influence_level", "relationship_strength", "last_contacted_on", "notes",
    "privacy_section", "do_not_email", "do_not_call", "contains_sensitive_data"
  ],
  "fields": [
    {"fieldname": "identity_section", "fieldtype": "Section Break", "label": "Contact Identity"},
    {"fieldname": "full_name", "fieldtype": "Data", "label": "Full Name", "reqd": 1, "in_list_view": 1, "in_global_search": 1},
    {"fieldname": "organization", "fieldtype": "Link", "label": "Organization", "options": "CRM Organization", "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "job_title", "fieldtype": "Data", "label": "Job Title"},
    {"fieldname": "department", "fieldtype": "Data", "label": "Department"},
    {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Active\nInactive\nLeft Organization\nDo Not Contact", "default": "Active", "reqd": 1, "in_list_view": 1},
    {"fieldname": "is_primary", "fieldtype": "Check", "label": "Primary Contact", "default": 0},
    {"fieldname": "communication_section", "fieldtype": "Section Break", "label": "Communication"},
    {"fieldname": "email", "fieldtype": "Data", "label": "Email", "options": "Email", "in_list_view": 1},
    {"fieldname": "mobile_no", "fieldtype": "Data", "label": "Mobile", "options": "Phone"},
    {"fieldname": "preferred_channel", "fieldtype": "Select", "label": "Preferred Channel", "options": "Email\nPhone\nSMS\nWhatsApp\nVideo Meeting\nIn Person", "default": "Email"},
    {"fieldname": "preferred_language", "fieldtype": "Select", "label": "Preferred Language", "options": "English\nArabic", "default": "English"},
    {"fieldname": "timezone", "fieldtype": "Data", "label": "Timezone", "default": "Asia/Riyadh"},
    {"fieldname": "relationship_section", "fieldtype": "Section Break", "label": "Relationship"},
    {"fieldname": "buying_role", "fieldtype": "Select", "label": "Buying Role", "options": "Decision Maker\nExecutive Sponsor\nChampion\nInfluencer\nEvaluator\nProcurement\nLegal\nEnd User\nBlocker"},
    {"fieldname": "influence_level", "fieldtype": "Select", "label": "Influence", "options": "High\nMedium\nLow"},
    {"fieldname": "relationship_strength", "fieldtype": "Int", "label": "Relationship Strength", "default": 50},
    {"fieldname": "last_contacted_on", "fieldtype": "Datetime", "label": "Last Contacted On", "read_only": 1},
    {"fieldname": "notes", "fieldtype": "Text Editor", "label": "Notes"},
    {"fieldname": "privacy_section", "fieldtype": "Section Break", "label": "Privacy Controls"},
    {"fieldname": "do_not_email", "fieldtype": "Check", "label": "Do Not Email", "default": 0, "permlevel": 1},
    {"fieldname": "do_not_call", "fieldtype": "Check", "label": "Do Not Call", "default": 0, "permlevel": 1},
    {"fieldname": "contains_sensitive_data", "fieldtype": "Check", "label": "Contains Sensitive Data", "default": 0, "permlevel": 1}
  ],
  "permissions": [
    {"role": "CRM Sales User", "read": 1, "write": 1, "create": 1, "email": 1, "print": 1},
    {"role": "CRM Sales Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "email": 1, "export": 1, "print": 1, "report": 1},
    {"role": "CRM Sales Manager", "permlevel": 1, "read": 1, "write": 1},
    {"role": "CRM Analyst", "read": 1, "report": 1},
    {"role": "CRM Compliance Manager", "read": 1, "write": 1, "export": 1, "report": 1},
    {"role": "CRM Compliance Manager", "permlevel": 1, "read": 1, "write": 1},
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "export": 1, "print": 1, "report": 1},
    {"role": "System Manager", "permlevel": 1, "read": 1, "write": 1}
  ]
}

